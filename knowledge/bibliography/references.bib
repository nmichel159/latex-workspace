% VERIFIED 2026-10-07 (dblp, STOC '71, pages 151-158).
% Crossref record rechecked 2026-10-09 (title, author, pages 151-158, 1971, ACM Press, New York).
% Content read 2026-10-09 (scan on the author's page cs.toronto.edu/~sacook): Theorem 1 (p. 152) reduces every set
% accepted in nondeterministic polynomial time to DNF tautologies; Theorem 2 (p. 153) shows that {tautologies},
% {DNF tautologies}, D3 (DNF tautologies with at most three conjuncts per disjunct) and {subgraph pairs} are
% P-reducible to each other. The complement of D3 is satisfiability of CNF formulas with at most three literals
% per clause. P-reducible is polynomial-time reducibility with an oracle (query machine), not the many-one
% reducibility of NP-completeness; the term NP-complete does not occur.
@inproceedings{Cook1971Complexity,
  author    = {Cook, Stephen A.},
  title     = {The Complexity of Theorem-Proving Procedures},
  booktitle = {Proceedings of the Third Annual ACM Symposium on Theory of Computing (STOC '71)},
  pages     = {151--158},
  publisher = {ACM},
  address   = {New York, NY, USA},
  year      = {1971},
  doi       = {10.1145/800157.805047}
}

